+async fn ensure_export_parent(
+    parent: &Path,
+    created_parents: &mut HashSet<PathBuf>,
+) -> anyhow::Result<()> {
+    if !created_parents.contains(parent) {
+        tokio::fs::create_dir_all(parent).await.map_err(|e| {
+            anyhow::anyhow!("failed creating export parent {}: {}", parent.display(), e)
+        })?;
+        created_parents.insert(parent.to_path_buf());
+    }
+    Ok(())
